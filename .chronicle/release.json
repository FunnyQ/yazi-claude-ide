{
  "mode": "whole-repo",
  "workflow": "github-flow",
  "tag": "v{version}",
  "changelog": "CHANGELOG.md",
  "branches": {
    "main": "main"
  },
  "versionFiles": [
    {
      "path": "Cargo.toml",
      "kind": "toml"
    },
    {
      "path": "Cargo.lock",
      "pattern": "name = \"yazi-claude-ide\"\\nversion = \"([^\"]+)\""
    }
  ]
}
